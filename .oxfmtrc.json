{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true,
    "groups": [
      ["builtin", "protocol"],
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "customGroups": [
      {
        "groupName": "protocol",
        "elementNamePattern": ["cloudflare:*", "bun:*"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "**/*.{md,mdx,yml,yaml,toml,html,graphql,hbs,vue,svelte,astro,scss,less}"
  ]
}
