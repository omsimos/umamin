{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "TURSO_*",
        "GOOGLE_*",
        "KV_REST_API_*",
        "CRON_SECRET",
        "AES_256_GCM_KEY",
        "R2_*",
        "NEXT_PUBLIC_APP_URL"
      ]
    }
  }
}
