{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umamin-web",
  "main": "./src/server.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "TODO"
    }
  ],
  // Workers Rate Limiting bindings (unsafe). period is 10 or 60 only.
  // Covers 7 of 8 limiters; group-edit (2/day) moves to Turso.
  "unsafe": {
    "bindings": [
      {
        "name": "RL_AUTH",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "RL_MESSAGE",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RL_WRITE",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "RL_GROUP_JOIN",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 8, "period": 60 }
      },
      {
        "name": "RL_READ",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": { "limit": 100, "period": 60 }
      },
      {
        "name": "RL_GROUP_MESSAGE",
        "type": "ratelimit",
        "namespace_id": "1006",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "RL_GROUP_READ",
        "type": "ratelimit",
        "namespace_id": "1007",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  "triggers": {
    // sessions cleanup, notifications cleanup, hot-feed recompute
    "crons": ["0 3 * * *", "0 4 * * *", "*/5 * * * *"]
  },
  "vars": {
    "APP_URL": "https://next.umamin.link"
  }
}
