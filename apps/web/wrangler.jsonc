{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two-environment layout (Vercel-style preview/prod). ALWAYS deploy with
  // --env; bindings/vars/routes are per-env and deliberately NOT shared.
  //   staging    → worker "umamin-web" (kept: it already holds dev.umamin.link
  //                and the dev secrets) — Turso umamin-dev, staging KV.
  //   production → worker "umamin-web-production" — Turso umamin-db, own KV;
  //                umamin.link is attached at cutover.
  // Local dev/preview pick an env via CLOUDFLARE_ENV (package.json scripts).
  "name": "umamin-web-dev",
  "main": "./src/server.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "umamin-web",
      // Full trace sampling: this is the low-traffic host, and it is the one
      // running the placement experiment below — the comparison against
      // production is the whole point, so it must not be sparsely sampled.
      "observability": {
        "enabled": true,
        "traces": { "enabled": true }
      },
      "routes": [
        {
          "pattern": "dev.umamin.link",
          "custom_domain": true
        }
      ],
      // EXPERIMENT (staging only — do NOT copy to production before measuring).
      //
      // Turso lives in aws ap-northeast-1. Measured from a Singapore colo, one
      // round trip to it costs ~75-90ms, and the read paths chain several: the
      // public profile is two (profile, then the badge it points at), the feed
      // four to five. That chain, not query cost, is what dominates TTFB —
      // /api/health returns in ~230ms where a cache-busted feed read takes
      // ~600-700ms.
      //
      // A placement hint runs the Worker in the Cloudflare data center nearest
      // that region, so each hop drops to single-digit ms. The trade is one
      // extra eyeball->Tokyo leg per request, paid ONCE instead of per hop.
      //
      // CAVEAT: the Cache API is local to the data center the Worker runs in,
      // so with placement on, `caches.default` entries live in Tokyo too — a
      // cache HIT gets slower by that same leg while every MISS gets much
      // faster. Workers Caching (`cache.enabled`) sits in front of the Worker
      // and is consulted before placement, which would remove the caveat; it
      // is the follow-up, not a prerequisite for measuring this.
      "placement": {
        "region": "aws:ap-northeast-1"
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "6dcbf8d991fe4123b2b6eb2a0dfd0fb3"
        }
      ],
      // Workers Rate Limiting bindings (unsafe). period is 10 or 60 only;
      // group-edit (2/day) moves to Turso. namespace_ids are account-global —
      // staging uses 1001-1007, production 2001-2007, so the two environments
      // never share limiter counters (same IP hitting both must not drain one
      // budget).
      "unsafe": {
        "bindings": [
          {
            "name": "RL_AUTH",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 5, "period": 60 }
          },
          {
            "name": "RL_MESSAGE",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 }
          },
          {
            "name": "RL_WRITE",
            "type": "ratelimit",
            "namespace_id": "1003",
            "simple": { "limit": 30, "period": 60 }
          },
          {
            "name": "RL_GROUP_JOIN",
            "type": "ratelimit",
            "namespace_id": "1004",
            "simple": { "limit": 8, "period": 60 }
          },
          {
            "name": "RL_READ",
            "type": "ratelimit",
            "namespace_id": "1005",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "RL_GROUP_MESSAGE",
            "type": "ratelimit",
            "namespace_id": "1006",
            "simple": { "limit": 30, "period": 60 }
          },
          {
            "name": "RL_GROUP_READ",
            "type": "ratelimit",
            "namespace_id": "1007",
            "simple": { "limit": 60, "period": 60 }
          }
        ]
      },
      "triggers": {
        // sessions cleanup, notifications cleanup, hot-feed recompute
        "crons": ["0 3 * * *", "0 4 * * *", "*/5 * * * *"]
      },
      "vars": {
        "APP_URL": "https://dev.umamin.link",
        // Not set automatically on Workers; session cookie names (__Host-*)
        // and secure attrs key off it. Local dev overrides via .dev.vars.
        "NODE_ENV": "production",
        // Staging serves the SAME public/robots.txt as production (static assets
        // are shared), and Cloudflare has no Vercel-style automatic
        // preview-noindex — so opt out via a header instead, or dev.umamin.link
        // gets crawled and competes with prod. See server-lib/csp.ts.
        "SEO_INDEXABLE": "false",
        // Worker-side error tracking (server-lib/posthog.ts). The project token
        // only writes events and is already in the browser bundle, so it is a
        // var, not a secret. Both environments report into the one "Umamin"
        // project; POSTHOG_ENV is what tells them apart there. Capture is gated
        // on NODE_ENV=production, so local dev inherits these harmlessly.
        "POSTHOG_PROJECT_TOKEN": "phc_dgBp0oWW82kMRiBevIGjWn46BiEvpnmjCoVuJ3L2MyE",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_ENV": "staging",
        // Feature flags gate PRODUCTION ONLY. dev.umamin.link is where Pro is
        // demoed and worked on, so the offer stays visible here no matter what
        // the PostHog rollout says. Comma-separated flag keys; local dev reads
        // this same block (CLOUDFLARE_ENV=staging), so Pro works locally too.
        // A flag that SHOULD be previewable in its hidden state is left out.
        "FLAGS_FORCE_ON": "umamin-pro"
      }
    },
    "production": {
      "name": "umamin-web-production",
      // Automatic tracing: spans for the handler, every outbound fetch (each
      // Turso round trip) and every binding call, with no code change. That is
      // exactly the instrument the "Cost & latency" numbers were measured by
      // hand for, and what the staging placement experiment needs to be
      // compared against.
      //
      // SAMPLED, and the rate is not cosmetic: each span is one observability
      // event drawing on the SAME 20M/month included quota as Workers Logs.
      // Production runs ~2.0M invocations/month and a feed request emits
      // roughly 6-10 spans (session read + 4-5 chained feed reads + KV +
      // rate-limit bindings), so 100% sampling is ~12-20M spans/month — the
      // entire allowance, before logs. 10% keeps it near 2M while still
      // tracing ~6.5k requests/day, far more than percentiles need.
      // Tracing is free until 2026-10-01, then billed at $0.60/M over quota.
      "observability": {
        "enabled": true,
        "traces": { "enabled": true, "head_sampling_rate": 0.1 }
      },
      // Dark until cutover: no public workers.dev URL in front of the prod DB.
      // Flip to true briefly if a pre-cutover prod smoke test is needed.
      "workers_dev": false,
      // umamin.link is attached at cutover (Phase 6):
      // "routes": [
      //   { "pattern": "umamin.link", "custom_domain": true },
      //   { "pattern": "www.umamin.link", "custom_domain": true }
      // ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "568d96f109aa46a28e0cb7ed31294147"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "RL_AUTH",
            "type": "ratelimit",
            "namespace_id": "2001",
            "simple": { "limit": 5, "period": 60 }
          },
          {
            "name": "RL_MESSAGE",
            "type": "ratelimit",
            "namespace_id": "2002",
            "simple": { "limit": 10, "period": 60 }
          },
          {
            "name": "RL_WRITE",
            "type": "ratelimit",
            "namespace_id": "2003",
            "simple": { "limit": 30, "period": 60 }
          },
          {
            "name": "RL_GROUP_JOIN",
            "type": "ratelimit",
            "namespace_id": "2004",
            "simple": { "limit": 8, "period": 60 }
          },
          {
            "name": "RL_READ",
            "type": "ratelimit",
            "namespace_id": "2005",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "RL_GROUP_MESSAGE",
            "type": "ratelimit",
            "namespace_id": "2006",
            "simple": { "limit": 30, "period": 60 }
          },
          {
            "name": "RL_GROUP_READ",
            "type": "ratelimit",
            "namespace_id": "2007",
            "simple": { "limit": 60, "period": 60 }
          }
        ]
      },
      "triggers": {
        "crons": ["0 3 * * *", "0 4 * * *", "*/5 * * * *"]
      },
      "vars": {
        "APP_URL": "https://www.umamin.link",
        "NODE_ENV": "production",
        // The ONLY environment that may be indexed.
        "SEO_INDEXABLE": "true",
        "POSTHOG_PROJECT_TOKEN": "phc_dgBp0oWW82kMRiBevIGjWn46BiEvpnmjCoVuJ3L2MyE",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_ENV": "production"
        // NO "FLAGS_FORCE_ON" here, deliberately — this is the one environment
        // the flags actually gate. Copying staging's vars block over would
        // launch every listed flag to everyone at once.
      }
    }
  }
}
