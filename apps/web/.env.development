# ── apps/web · LOCAL DEV ─────────────────────────────────────────────────────
# Public client config for `pnpm dev:web` (vite mode "development").
#
# COMMITTED, on purpose: vite embeds every VITE_* value in the browser bundle,
# so nothing here is a secret — it is all already published to every visitor.
# Keeping it in git means a fresh clone runs without setup.
#
# Secrets do NOT go in this file. Local ones live in `.dev.vars`; deployed ones
# live in Cloudflare. See ENVIRONMENT.md.

# --- Identity ---------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
VITE_VERIFIED_USERS='joshxfi'

# --- Assets & push ----------------------------------------------------------
VITE_R2_PUBLIC_URL=https://umamin-dev-cdn.omsimos.org
VITE_VAPID_PUBLIC_KEY=BG5HmkRNjmdP2lZ7KQ3aIlPE4NdLQwyQthWeYJAQdEL73EUbNPVxCrnHIziuCz1LDZq4O66fDBd0VSoSX6icBfQ

# --- Surfaces ---------------------------------------------------------------
VITE_SOCIAL_UNDER_MAINTENANCE=false
# Keeps the labelled placeholder boxes visible while working on layout.
VITE_ADS_ENABLED=true

# --- Analytics & error tracking ---------------------------------------------
# Unset: GTM and the PostHog SDK only initialize in PROD builds, so a value
# here would do nothing.
VITE_GTM_ID=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
