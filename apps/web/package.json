{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=staging vite dev",
    "build": "CLOUDFLARE_ENV=staging vite build --mode staging && tsc --noEmit",
    "build:production": "CLOUDFLARE_ENV=production vite build && tsc --noEmit",
    "preview": "CLOUDFLARE_ENV=staging vite preview",
    "deploy": "pnpm run build && wrangler deploy --env staging",
    "deploy:production": "pnpm run build:production && wrangler deploy --env production",
    "cf-typegen": "wrangler types --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .wrangler node_modules"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.6",
    "@libsql/client": "^0.17.3",
    "@mmmike/web-push": "^0.1.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-with-query": "1.130.17",
    "@tanstack/react-start": "1.168.32",
    "@umamin/db": "workspace:*",
    "@umamin/encryption": "workspace:*",
    "@umamin/ui": "workspace:*",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "hono": "^4.12.31",
    "lucide-react": "^1.17.0",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "wrangler": "^4.114.0"
  }
}
