{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=staging vite dev",
    "build": "CLOUDFLARE_ENV=staging vite build --mode staging && tsc --noEmit && node scripts/posthog-sourcemaps.mjs",
    "build:production": "CLOUDFLARE_ENV=production vite build && tsc --noEmit && node scripts/posthog-sourcemaps.mjs",
    "preview": "CLOUDFLARE_ENV=staging vite preview",
    "deploy": "pnpm run build && wrangler deploy --env staging",
    "deploy:production": "pnpm run build:production && wrangler deploy --env production",
    "cf-typegen": "wrangler types --env staging",
    "secrets:staging": "node scripts/push-secrets.mjs staging",
    "secrets:production": "node scripts/push-secrets.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .wrangler node_modules"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@mmmike/web-push": "^1.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.53",
    "@umamin/db": "workspace:*",
    "@umamin/encryption": "workspace:*",
    "@umamin/ui": "workspace:*",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "blobatar": "^2.7.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.7",
    "lucide-react": "^1.45.0",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.430.3",
    "posthog-node": "^5.52.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@mdx-js/rollup": "^3.1.1",
    "@posthog/cli": "^0.18.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
