# Public client configuration only. Never put secrets in VITE_* variables:
# Vite embeds their values in the browser bundle.
#
# The per-mode .env.development/.env.staging/.env.production files are
# gitignored, so they only configure LOCAL builds. Cloudflare Workers Builds
# builds from a clean clone and reads these from its own build variables — a
# value has to be set THERE (per environment) to reach a deploy.
#
# Server-side secrets (Turso, AES, OAuth, VAPID private, R2, MODERATOR_USERS,
# LEMONSQUEEZY_*) do NOT belong here — see .dev.vars.example for the local
# copy, and `wrangler secret put` for deployed values.
VITE_SITE_URL=http://localhost:5173
# Must decode to a 65-byte P-256 point: 87 base64url chars, and must match the
# Worker's VAPID_PUBLIC_KEY secret. Anything else makes pushManager.subscribe()
# throw and push enrollment fail.
VITE_VAPID_PUBLIC_KEY=
VITE_R2_PUBLIC_URL=
VITE_VERIFIED_USERS=
VITE_GTM_ID=
VITE_SOCIAL_UNDER_MAINTENANCE=false
# "false" removes every ad surface — placements, the space they reserve, in-feed
# units, and the adsbygoogle loader. Any other value (including unset) keeps ads
# on, so a typo can't silently drop revenue.
VITE_ADS_ENABLED=true

# Browser error tracking (PostHog project "Umamin"). The project token is public
# — it can only write events — so it belongs here rather than in .dev.vars.
# Only PROD builds initialize the SDK, so `pnpm dev:web` never sends events.
# Adding a host here means adding it to server-lib/csp.ts too.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
