# ── apps/web · PRODUCTION — www.umamin.link ──────────────────────────────────
# Public client config for `pnpm --filter=web build:production`.
#
# COMMITTED, and this is what the deploy actually ships: Workers Builds builds
# from a clean clone, so this file reaches the build. Nothing here is a secret —
# vite embeds every VITE_* value in the browser bundle.
#
# A Workers Builds *build variable* of the same name still wins (vite applies
# process.env after file values), so any leftover dashboard variable overrides
# this file. Clear the dashboard ones and let git be the source of truth.
#
# Secrets do NOT go in this file. See ENVIRONMENT.md.

# --- Identity ---------------------------------------------------------------
# Must match the host in public/robots.txt + public/sitemap.xml (mixed hosts
# across canonical/OG/sitemap read as duplicates).
VITE_SITE_URL=https://www.umamin.link
VITE_VERIFIED_USERS=josh,umamin,hyamero

# --- Assets & push ----------------------------------------------------------
VITE_R2_PUBLIC_URL=https://umamin-cdn.omsimos.org
# Own keypair, not staging's — the private half is the production Worker's
# VAPID_PRIVATE_KEY secret and the two must be from the same pair.
VITE_VAPID_PUBLIC_KEY=BDx7os4dXoUG6EBgNUQBPAL4lvDkPb7rgAYzvxx7pbb_i3gXXSgXjs2xehJThDnUjYQSsCT4-jWKUhUbkV3HPEo

# --- Surfaces ---------------------------------------------------------------
VITE_SOCIAL_UNDER_MAINTENANCE=false
# The live switch. Set to false and redeploy to remove every ad surface.
VITE_ADS_ENABLED=true

# --- Analytics & error tracking ---------------------------------------------
VITE_GTM_ID=GTM-WLRTRLC7
VITE_POSTHOG_PROJECT_TOKEN=phc_dgBp0oWW82kMRiBevIGjWn46BiEvpnmjCoVuJ3L2MyE
VITE_POSTHOG_HOST=https://us.i.posthog.com
