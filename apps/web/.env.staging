# ── apps/web · STAGING — dev.umamin.link ─────────────────────────────────────
# Public client config for `pnpm --filter=web build` (vite mode "staging").
#
# COMMITTED, and this is what the deploy actually ships: Workers Builds builds
# from a clean clone, so this file reaches the build. Nothing here is a secret —
# vite embeds every VITE_* value in the browser bundle.
#
# A Workers Builds *build variable* of the same name still wins (vite applies
# process.env after file values), so any leftover dashboard variable overrides
# this file. Clear the dashboard ones and let git be the source of truth.
#
# Secrets do NOT go in this file. See ENVIRONMENT.md.

# --- Identity ---------------------------------------------------------------
# Must match the host in public/robots.txt + public/sitemap.xml (mixed hosts
# across canonical/OG/sitemap read as duplicates).
VITE_SITE_URL=https://dev.umamin.link
VITE_VERIFIED_USERS='joshxfi'

# --- Assets & push ----------------------------------------------------------
VITE_R2_PUBLIC_URL=https://umamin-dev-cdn.omsimos.org
VITE_VAPID_PUBLIC_KEY=BG5HmkRNjmdP2lZ7KQ3aIlPE4NdLQwyQthWeYJAQdEL73EUbNPVxCrnHIziuCz1LDZq4O66fDBd0VSoSX6icBfQ

# --- Surfaces ---------------------------------------------------------------
VITE_SOCIAL_UNDER_MAINTENANCE=false
# Off on the preview host: it is noindex, earns nothing, and live ads there only
# muddy the AdSense numbers. Flip to true to rehearse the real layout.
VITE_ADS_ENABLED=false

# --- Analytics & error tracking ---------------------------------------------
# No GTM on the preview host — product analytics would mix with production's.
VITE_GTM_ID=
# Same PostHog project as production; the `environment` property (from the vite
# mode) is what separates the two there.
VITE_POSTHOG_PROJECT_TOKEN=phc_dgBp0oWW82kMRiBevIGjWn46BiEvpnmjCoVuJ3L2MyE
VITE_POSTHOG_HOST=https://us.i.posthog.com
